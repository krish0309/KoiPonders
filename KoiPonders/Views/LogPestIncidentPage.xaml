<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:vm="clr-namespace:KoiPonders.ViewModels"
			 xmlns:controls="clr-namespace:KoiPonders.Controls"
			 x:Class="KoiPonders.Views.LogPestIncidentPage"
			 x:DataType="vm:LogPestIncidentViewModel"
			 Shell.NavBarIsVisible="False"
			 Title="Log Pest Incident">

	<Grid ColumnDefinitions="212,*" BackgroundColor="{StaticResource FgRail}">

		<controls:FarmSidebar Grid.Column="0" ActiveRoute="LogIncidentPage" />

		<ScrollView Grid.Column="1">
			<VerticalStackLayout Padding="24" Spacing="18">

				<VerticalStackLayout Spacing="2">
					<Label Text="Log Pest Incident" TextColor="White" FontSize="22" FontAttributes="Bold" />
					<Label Text="Detailed geospatial incident record" TextColor="#9FBBAC" FontSize="13" />
				</VerticalStackLayout>

				<Border StrokeThickness="0" BackgroundColor="#16321F" StrokeShape="RoundRectangle 14" Padding="20">
					<VerticalStackLayout Spacing="14">

						<Label Text="Affected Field" TextColor="#9FBBAC" FontSize="12" />
						<Picker ItemsSource="{Binding Fields}" ItemDisplayBinding="{Binding Name}"
								SelectedItem="{Binding SelectedField}" Title="Select a field"
								TextColor="White" TitleColor="#9FBBAC" BackgroundColor="#0E241A" />

						<Label Text="Problem Name" TextColor="#9FBBAC" FontSize="12" />
						<Entry Placeholder="e.g. Corn earworm" Text="{Binding ProblemName}"
							   TextColor="White" PlaceholderColor="#5E8570" BackgroundColor="#0E241A" />

						<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
							<VerticalStackLayout Grid.Column="0" Spacing="4">
								<Label Text="Category" TextColor="#9FBBAC" FontSize="12" />
								<Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
										TextColor="White" BackgroundColor="#0E241A" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1" Spacing="4">
								<Label Text="Severity" TextColor="#9FBBAC" FontSize="12" />
								<Picker ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"
										TextColor="White" BackgroundColor="#0E241A" />
							</VerticalStackLayout>
						</Grid>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
							<VerticalStackLayout Grid.Column="0" Spacing="4">
								<Label Text="Status" TextColor="#9FBBAC" FontSize="12" />
								<Picker ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"
										TextColor="White" BackgroundColor="#0E241A" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1" Spacing="4">
								<Label Text="{Binding AffectedAreaPercent, StringFormat='Affected Area: {0:0}%'}"
									   TextColor="#9FBBAC" FontSize="12" />
								<Slider Minimum="0" Maximum="100" Value="{Binding AffectedAreaPercent}"
										MinimumTrackColor="{StaticResource FgAccent}" ThumbColor="{StaticResource FgAccent}" />
							</VerticalStackLayout>
						</Grid>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
							<VerticalStackLayout Grid.Column="0" Spacing="4">
								<Label Text="Observed Date" TextColor="#9FBBAC" FontSize="12" />
								<DatePicker Date="{Binding ObservedDate}" TextColor="White" BackgroundColor="#0E241A" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1" Spacing="4">
								<Label Text="Follow-up Date" TextColor="#9FBBAC" FontSize="12" />
								<DatePicker Date="{Binding FollowUpDate}" TextColor="White" BackgroundColor="#0E241A" />
							</VerticalStackLayout>
						</Grid>

						<Label Text="Field Notes" TextColor="#9FBBAC" FontSize="12" />
						<Editor Placeholder="Describe symptoms, spread, treatment plan…" Text="{Binding Notes}"
								HeightRequest="120" TextColor="White" PlaceholderColor="#5E8570" BackgroundColor="#0E241A" />

						<Label Text="Report Location" TextColor="#9FBBAC" FontSize="12" />
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
							<Label Grid.Column="0" Text="{Binding LocationText}" TextColor="White" FontSize="13"
									VerticalOptions="Center" />
							<Button Grid.Column="1" Text="📍 Pick on Map" Command="{Binding PickLocationCommand}"
									BackgroundColor="#1B3B2A" TextColor="White" CornerRadius="8" Padding="12,6" />
						</Grid>

						<Button Text="Submit Report" Command="{Binding SubmitCommand}"
								Style="{StaticResource FgPrimaryButton}" />

						<Label Text="{Binding StatusMessage}" TextColor="{StaticResource FgAccent}" FontSize="12" />
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>
