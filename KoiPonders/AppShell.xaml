<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KoiPonders.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KoiPonders"
    xmlns:views="clr-namespace:KoiPonders.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="KoiPonders">

    <FlyoutItem Title="Farm Map">
        <ShellContent
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Fields">
        <ShellContent
            ContentTemplate="{DataTemplate views:FieldsPage}"
            Route="FieldsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Reports">
        <ShellContent
            ContentTemplate="{DataTemplate views:ReportsPage}"
            Route="ReportsPage" />
    </FlyoutItem>

</Shell>
